# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: bypasses RLS for admin operations (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: direct Postgres connection (Supabase → Project Settings → Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# Optional: protect GET /api/contact for viewing submissions in-app
ADMIN_API_KEY=your-secret-admin-key
